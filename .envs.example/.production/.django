# Production template. Every CHANGEME is a real secret and is generated per
# environment. Nothing in .envs/ is ever committed: this repository is public.

# General
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=CHANGEME
DJANGO_ADMIN_URL=CHANGEME/
DJANGO_ALLOWED_HOSTS=.example.com

# Security
# ------------------------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=False

# Email
# ------------------------------------------------------------------------------
DJANGO_SERVER_EMAIL=

# django-allauth
# ------------------------------------------------------------------------------
DJANGO_ACCOUNT_ALLOW_REGISTRATION=True

# Gunicorn
# ------------------------------------------------------------------------------
WEB_CONCURRENCY=4

# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# Celery
# ------------------------------------------------------------------------------

# Flower
CELERY_FLOWER_USER=CHANGEME
CELERY_FLOWER_PASSWORD=CHANGEME

# Website integration
# ------------------------------------------------------------------------------
SITIO_BASE_URL=https://easyoffice.cl
PORTAL_BASE_URL=https://tramites.easyoffice.cl
# Generate at least 32 random bytes. Left empty, the webhook rejects everything.
WEBHOOK_SITIO_TOKEN=
WEBHOOK_SITIO_THROTTLE_RATE=60/min
# Set to the number of reverse proxies in front of Django, or client IPs are spoofable.
# DJANGO_NUM_PROXIES=1
# DJANGO_CORS_ALLOWED_ORIGINS=
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.easyoffice.cl
# DJANGO_SESSION_COOKIE_DOMAIN=
