# Local development only. These values are not secrets: the services they
# reach are containers on this machine, not exposed outside Docker. Never
# reuse them anywhere else.

# General
# ------------------------------------------------------------------------------
USE_DOCKER=yes
IPYTHONDIR=/app/.ipython

# Session
# ------------------------------------------------------------------------------
# Idle seconds before the session expires. Pending validation with Easy Office.
DJANGO_SESSION_INACTIVITY_SECONDS=1800

# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# Celery
# ------------------------------------------------------------------------------

# Flower
CELERY_FLOWER_USER=localdev
CELERY_FLOWER_PASSWORD=localdev

# Payments
# ------------------------------------------------------------------------------
# Payment methods the client can choose from, in order: klap, flow,
# simulated. For Klap's sandbox, copy the test API key from
# https://developers.klap.cl/datos-de-prueba. For Flow's, create an account
# at https://sandbox.flow.cl and copy apiKey and secretKey from "Mis datos".
PAYMENT_PROVIDERS=simulated
KLAP_API_KEY=
FLOW_API_KEY=
FLOW_SECRET_KEY=
# Klap refuses orders without public HTTPS webhook URLs. Locally the "tunnel"
# service provides one and the backend reads it from the line below.
# PAYMENT_WEBHOOK_BASE_URL, when set, takes precedence (add its host to
# DJANGO_EXTRA_ALLOWED_HOSTS).
PAYMENT_TUNNEL_METRICS_URL=http://tunnel:2000/quicktunnel
PAYMENT_WEBHOOK_BASE_URL=
DJANGO_EXTRA_ALLOWED_HOSTS=
PORTAL_BASE_URL=http://localhost:5173

# Documents
# ------------------------------------------------------------------------------
# Word-to-PDF conversion of generated contracts (gotenberg | simulated).
PDF_CONVERTER=gotenberg
GOTENBERG_URL=http://gotenberg:3000
